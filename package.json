{
	"name": "mozaik-claude-code",
	"version": "0.1.3",
	"private": true,
	"description": "Connects Claude Code sessions to a Mozaik network: see the other sessions and exchange messages with them as they work.",
	"license": "MIT",
	"scripts": {
		"build": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.cjs",
		"test": "rstest run",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@jigjoy/mozaik-network": "^0.1.0",
		"@jigjoy/mozaik-rule-engine": "^0.0.2",
		"@modelcontextprotocol/sdk": "^1.32.2"
	},
	"devDependencies": {
		"@rstest/core": "0.12.4",
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"mozaik-network": "github:jigjoy-ai/mozaik-network#development",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
